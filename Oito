#include <stdio.h>

int main() {
    int array[5];
    int *ptr = array;
    int i;

    printf("Insira 5 numeros:\n");

    for (i = 0; i < 5; i++) {
        while (1) {
            printf("Numero %d: ", i + 1);

            if (scanf("%d", ptr + i) == 1) {
                break; 
            } else {
                printf("Entrada invalida. Tente novamente.\n");

        
                while (getchar() != '\n');

                ptr[i] = 0;
            }
        }
    }

    printf("\nDobro dos valores:\n");

    for (i = 0; i < 5; i++) {
        printf("%d\n", *(ptr + i) * 2);
    }

    return 0;
}
